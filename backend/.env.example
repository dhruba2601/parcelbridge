# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Storage Driver: 'supabase' for production PostgreSQL, 'memory' for local demo/testing without Supabase
STORAGE_DRIVER=memory
DEMO_MODE=true

# Supabase Credentials (SERVER ONLY - NEVER expose service-role key to frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security Secrets (Use 32+ random characters in production)
JWT_SECRET=replace-with-secure-64-char-random-secret-in-production
JWT_EXPIRES_IN=12h
QR_HMAC_SECRET=replace-with-secure-qr-hmac-secret-in-production
OTP_HMAC_SECRET=replace-with-secure-otp-hmac-secret-in-production
WEBHOOK_SHARED_SECRET=replace-with-partner-webhook-shared-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=25
